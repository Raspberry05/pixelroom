{
  "name": "pixelroom",
  "private": true,
  "version": "0.1.0",
  "description": "Encrypted messaging game — shared pixel rooms with presence, actions, and Sims-like interaction",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @pixelroom/core -w @pixelroom/crypto",
    "test": "npm run test -w @pixelroom/core -w @pixelroom/crypto",
    "typecheck": "npm run typecheck -w @pixelroom/core -w @pixelroom/crypto -w @pixelroom/mobile",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
